<Project>

  <!-- 全解决方案共享的编译约定（与 Unity 客户端 EFramework 代码风格保持一致） -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>

    <!-- 与客户端对齐：不使用可空引用注解，避免 NRE 标注噪音污染从客户端同步的文件 -->
    <Nullable>disable</Nullable>

    <!-- 与客户端对齐：显式 using，不依赖隐式全局 using -->
    <ImplicitUsings>disable</ImplicitUsings>

    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!--
      告警抑制说明：
      CS1591 缺 XML 注释（本工程逐成员写注释，但接口实现与私有成员不强制）
      CA1716 接口成员名与其它语言关键字冲突（Stop / Error 是刻意选择的领域命名）
      CA1510/CA1513 建议改用 ThrowIfNull/ThrowIf（与 Unity 侧 ?? throw 写法保持一致，便于两侧对照阅读）
    -->
    <NoWarn>$(NoWarn);CS1591;CA1716;CA1510;CA1513</NoWarn>
  </PropertyGroup>

  <!--
    版本基线：与 Unity 包 cn.efefef.net 的 package.json version 保持完全一致。
    · 本服务端是该包的协议对端，版本号唯一有意义的锚点就是它所实现的包版本。
    · 协议层（帧格式 / Opcode 语义 / KCP 参数）有任何变动 = 客户端需同步升级，两侧版本必须一起动。
    · 升级 EF 时改这一处；tools/sync-protocol.py 的校验模式会检查两者是否漂移。
  -->
  <PropertyGroup>
    <Version>0.0.1</Version>
  </PropertyGroup>

</Project>
