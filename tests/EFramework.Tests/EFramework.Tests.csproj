<Project Sdk="Microsoft.NET.Sdk">

  <!--
    零依赖验证工程：控制台 + 真实 UDP 回环。
    不引入 xunit/nunit，保证离线可跑（dotnet run 即可），并兼作手工联调的协议探针。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>EFramework.Tests</AssemblyName>
    <RootNamespace>EFramework.Tests</RootNamespace>
    <Description>EF.Net 服务端协议一致性与端到端验证</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EFramework.Server\EFramework.Server.csproj" />
    <ProjectReference Include="..\..\src\EFramework.Http\EFramework.Http.csproj" />
  </ItemGroup>

</Project>
